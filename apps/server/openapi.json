{
  "openapi": "3.1.0",
  "info": {
    "title": "Subify API",
    "version": "2"
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "v": {
            "type": "number",
            "enum": [
              2
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_link",
              "channel_not_found",
              "upstream_unavailable",
              "busy",
              "catalog_full"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "v",
          "error",
          "message"
        ]
      }
    },
    "parameters": {}
  },
