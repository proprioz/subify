              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/oprf": {
      "get": {
        "responses": {
          "200": {
            "description": "The VOPRF public key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "v": {
                      "type": "number",
                      "enum": [
                        3
                      ]
                    },
                    "keyId": {
                      "type": "integer"
                    },
                    "publicKey": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{43}$"
                    }
                  },
                  "required": [
                    "v",
                    "keyId",
                    "publicKey"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/oprf/evaluate": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "blinded": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{43}$"
                    }
                  }
                },
                "required": [
                  "blinded"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The evaluated elements and their proof",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "v": {
                      "type": "number",
                      "enum": [
                        3
                      ]
                    },
                    "evaluated": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{43}$"
                      }
                    },
                    "proof": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{86}$"
                    }
                  },
                  "required": [
                    "v",
                    "evaluated",
                    "proof"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stream": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,9}$"
            },
            "required": true,
            "name": "since",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,9}$"
            },
            "required": true,
            "name": "group",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The group’s entries in the batches after `since`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "v": {
                      "type": "number",
                      "enum": [
                        4
                      ]
                    },
                    "latest": {
                      "type": "number"
                    },
                    "groups": {
                      "type": "number"
                    },
                    "k": {
                      "type": "number"
                    },
                    "expired": {
                      "type": "boolean"
                    },
                    "more": {
                      "type": "boolean"
                    },
                    "page": {
                      "type": "number"
                    },
                    "batches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pass": {
                            "type": "number"
                          },
                          "entries": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "pass",
                          "entries"
                        ]
                      }
                    }
                  },
                  "required": [
                    "v",
                    "latest",
                    "groups",
                    "k",
                    "expired",
                    "more",
                    "page",
                    "batches"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Refused or failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
