    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "The API version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "v": {
                      "type": "number",
                      "enum": [
                        2
                      ]
                    },
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "commit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "v",
                    "ok",
                    "commit"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/connection": {
      "get": {
        "responses": {
          "200": {
