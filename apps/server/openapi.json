                        "SHA-256"
                      ]
                    },
                    "challenge": {
                      "type": "string"
                    },
                    "maxnumber": {
                      "type": "number"
                    },
                    "salt": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "v",
                    "algorithm",
                    "challenge",
                    "maxnumber",
                    "salt",
                    "signature"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Refused or failed",
