# Same variables as wrangler.toml [vars] / .dev.vars, plus the Node-only ones at the end.

# Required: what the installed app is called (on the home screen, in the app switcher). The
# server refuses to start without it. Its icon is the Subify icon in blue (red on subify.tv only).
INSTANCE_NAME=
# Optional: who runs this server and a contact for privacy requests, shown on the Privacy page.
OPERATOR_NAME=
OPERATOR_CONTACT=
# Optional: the contact form. Messages are emailed to MESSAGES_TO, which is never shown (nor is
# OPERATOR_CONTACT while the form is on). Empty turns the form off. MESSAGES_FROM defaults to MESSAGES_TO.
MESSAGES_TO=
MESSAGES_FROM=
# Sent to Wikidata only, to build the dictionary of channel names (see docs/SELF-HOSTING.md).
# Without it, there is no dictionary and channels are found by name less often.
WIKIDATA_USER_AGENT=

# Public URL of this server, used as the WebSub callback base. Leave empty when the server
# cannot be reached from the internet (local development): WebSub is then turned off and
# the pass's polling alone keeps the catalog up to date.
PUBLIC_BASE_URL=

# Optional address added to the User-Agent of every request. Leave empty to stay anonymous:
# the default User-Agent names no person, no instance and no project.
CONTACT_URL=

# Channels polled per minute of the pass's period, at most: the catalog's capacity follows from it.
POLL_BATCH_SIZE=5
# Items published longer ago than this are dropped by the pass and never ingested.
RETENTION_DAYS=183
# Channels that may enter the catalog per hour and per day, all users together. Past them a new
# channel is refused for a while (503 with Retry-After); channels the catalog knows never are.
NEW_CHANNELS_PER_HOUR=60
NEW_CHANNELS_PER_DAY=500
# Submissions that may read the platform per minute, failed ones included.
ONLINE_LOOKUPS_PER_MINUTE=10
# Blind lookups of up to 50 channels per minute, all devices together.
BLIND_BATCHES_PER_MINUTE=30
# Channels the server adds to the catalog on its own each day, on average, among those its videos
# link to, so that a channel in the catalog doesn't tell that someone follows it. 0, the default,
# turns seeding off: the catalog then holds only the channels users added.
SEEDED_CHANNELS_PER_DAY=0
# The master secret every table is encrypted with: 32 bytes in base64 (see docs/SELF-HOSTING.md).
# Without it, Node generates one in SECRET_PATH; a Worker refuses to serve.
MASTER_SECRET=

# The git commit this server was built from, shown by /api/health (CI sets it on Workers).
COMMIT=

# Node only.
PORT=8787
# Folder of the built PWA to serve on the same origin. Empty in development, where Vite serves it.
WEB_DIST=
# SQLite database file. The Docker image keeps it in the /data volume.
DATABASE_PATH=data/subify.sqlite
# The generated master secret, when MASTER_SECRET isn't set. Default: next to the database.
SECRET_PATH=
# The mail server the contact form sends through, e.g. smtps://user:password@mail.example.org:465.
# A secret. Without it the form stays off.
SMTP_URL=
