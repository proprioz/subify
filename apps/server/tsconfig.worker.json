{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "paths": {
      "#harness": [
        "./test/harness/workers.ts"
      ]
    }
  },
  "include": [
    "src",
    "test/workers",
    "test/shared",
