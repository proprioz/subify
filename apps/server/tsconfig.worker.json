    "test/harness/workers.ts",
    "test/harness/types.ts",
    "test/raw.d.ts",
    "test/env.d.ts",
    "test/harness/common.ts"
  ],
  "exclude": [
    "src/entry/node.ts",
    "src/node"
  ]
}
